# ============================================================
# 后端环境变量示例
# 使用方法：复制本文件为 .env，然后填入真实值（.env 不会被提交到 Git）
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ============================================================

# 服务器配置
PORT=3001

# JWT 密钥（生产环境请改成随机长字符串）
JWT_SECRET=请改成你自己的随机密钥

# 默认管理员账号（首次初始化数据库时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置一个强密码

# 上传文件目录（仅用于兼容历史文件，新上传会写入云存储）
UPLOAD_DIR=uploads

# CloudBase PostgreSQL 配置
CLOUDBASE_ENV_ID=your-env-id
# Publishable Key 已硬编码在 db/index.js 中作为默认值，也可在此覆盖
# CLOUDBASE_PUBLISHABLE_KEY=xxxxx

# CloudBase 云存储（PG 模式 pgstore）
# 服务端 API Key（service_role），用于把图片转存到云存储，切勿泄漏
CLOUDBASE_API_KEY=your-service-role-api-key
CLOUDBASE_STORAGE_BUCKET=blog
