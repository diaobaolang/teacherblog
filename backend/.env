# 服务器配置
PORT=3001

# JWT 密钥
JWT_SECRET=teacherblog-jwt-secret-2026

# 默认管理员账号（首次初始化数据库时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 上传文件目录（仅用于兼容历史文件，新上传会写入云存储）
UPLOAD_DIR=uploads

# CloudBase PostgreSQL 配置
CLOUDBASE_ENV_ID=teacherblog-d5gpp8xax79a35603
# Publishable Key 已硬编码在 db/index.js 中作为默认值，也可在此覆盖
# CLOUDBASE_PUBLISHABLE_KEY=xxxxx

# CloudBase 云存储（PG 模式 pgstore）
# 服务端 API Key（service_role），由 manageAppAuth(action="createApiKey") 创建，
# 用于把图片转存到云存储。生产环境同样作为云托管环境变量注入。
